# ReachInbox Scheduler - Backend Environment Configuration

NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:5173

# PostgreSQL Database Connection
# Format: postgresql://<user>:<password>@localhost:5432/reachinbox?schema=public
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/reachinbox?schema=public

# Redis Connection (BullMQ queues, atomic distributed spacing, hourly quotas)
# Local: redis://127.0.0.1:6379 or Upstash: rediss://default:<password>@<host>.upstash.io:6379
REDIS_URL=redis://127.0.0.1:6379

# Session / JWT Secret (Minimum 32 chars)
SESSION_SECRET=reachinbox_super_secret_session_key_32_chars_minimum!

# Symmetric 256-bit AES Encryption Key (64 hex characters)
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Google OAuth 2.0 (From Google Cloud Console: Credentials -> OAuth 2.0 Client IDs)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/api/auth/google/callback

# Nodemailer Ethereal SMTP Test Account
# Generated automatically via: npm run create:ethereal --workspace=backend
ETHEREAL_HOST=smtp.ethereal.email
ETHEREAL_PORT=587
ETHEREAL_USER=
ETHEREAL_PASSWORD=
DEFAULT_SENDER_EMAIL=outreach@example.com

# BullMQ Worker Concurrency and Rate Limits
WORKER_CONCURRENCY=3
MIN_DELAY_BETWEEN_EMAILS_SECONDS=2
MAX_EMAILS_PER_HOUR_PER_SENDER=100

# Elasticsearch Search Engine (Local or Cloud)
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_USERNAME=
ELASTICSEARCH_PASSWORD=

# Slack OAuth 2.0 (From Slack App -> OAuth & Permissions)
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_REDIRECT_URI=http://localhost:4000/api/slack/callback
