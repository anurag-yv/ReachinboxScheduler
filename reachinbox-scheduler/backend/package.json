{
  "name": "reachinbox-scheduler-backend",
  "version": "1.0.0",
  "description": "Backend API and BullMQ worker for ReachInbox Email Scheduler",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "worker": "tsx watch src/workers/emailWorker.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "start:worker": "node dist/workers/emailWorker.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:push": "prisma db push",
    "create:ethereal": "tsx src/scripts/createEtherealAccount.ts",
    "clear": "tsx src/scripts/clearHistory.ts"
  },
  "dependencies": {
    "@bull-board/api": "^5.21.3",
    "@bull-board/express": "^5.21.3",
    "@elastic/elasticsearch": "^8.13.1",
    "@prisma/client": "^5.13.0",
    "axios": "^1.6.8",
    "bullmq": "^5.7.9",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "csv-parse": "^5.5.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "google-auth-library": "^9.9.0",
    "ioredis": "^5.4.1",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^6.9.13",
    "zod": "^3.23.6"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.7",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.12.7",
    "@types/nodemailer": "^6.4.14",
    "@types/supertest": "^6.0.2",
    "prisma": "^5.13.0",
    "supertest": "^7.0.0",
    "tsx": "^4.7.2",
    "typescript": "^5.4.5",
    "vitest": "^1.5.2"
  }
}
